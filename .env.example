# PostgreSQL local administrado por compose.yaml.
# Son valores exclusivamente de desarrollo; cambia la contraseña en tu .env local.
POSTGRES_DB=agente_fitness
POSTGRES_USER=agente_fitness
POSTGRES_PASSWORD=change_me_local_only
POSTGRES_PORT=5432

# Puertos de los procesos locales iniciados por scripts/*.ps1.
BACKEND_PORT=8000
FRONTEND_PORT=5173

# Configuración específica:
# - frontend/.env.example
# - backend/.env.example
